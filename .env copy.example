# ASX StockWatch Configuration

# =====================================================
# AWS S3 Configuration
# =====================================================

AWS_REGION=ap-southeast-2
S3_BUCKET=your-asx-data-bucket-name
S3_BUCKET_NAME=your-asx-data-bucket-name
S3_STORAGE_CLASS=STANDARD_IA  # 46% cheaper than STANDARD

# S3 Lifecycle Rules (for automatic cost optimization)
# After 30 days: STANDARD_IA
# After 90 days: GLACIER
# After 365 days: DEEP_ARCHIVE

# =====================================================
# Data Pipeline Settings
# =====================================================

ASX_STOCKS_TOP_N=20
DATA_PERIOD_MONTHS=6
EXTRACTION_FREQUENCY=daily

COMPRESSION_FORMAT=snappy
FILE_FORMAT=parquet

# =====================================================
# Cost Monitoring
# =====================================================

S3_MAX_COST=2.00
TOTAL_MAX_COST=2.00

COST_ALERT_THRESHOLD=0.80
USAGE_REPORT_FREQUENCY=weekly

# =====================================================
# Local Development Settings
# =====================================================

DATA_DIR=data/
LOGS_DIR=logs/
TEMP_DIR=temp/

LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(levelname)s - %(message)s

# =====================================================
# Security Settings
# =====================================================

# AWS Credentials (use IAM roles in production)
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret

# =====================================================
# Dashboard Settings
# =====================================================

DASHBOARD_AUTO_REFRESH_MINUTES=60
CACHE_TTL_HOURS=24

DEFAULT_CHART_TYPE=line
COLOR_SCHEME=au_flag
